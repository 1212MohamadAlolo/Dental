{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning question",
  "type": "object",
  "required": [
    "id",
    "conceptId",
    "type",
    "prompt",
    "correctAnswer",
    "explanation",
    "hint",
    "sourceReference",
    "reviewStatus",
    "clinicalApproval"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceReference": {
      "type": "object",
      "required": [
        "document",
        "pdfPages"
      ],
      "properties": {
        "document": {
          "type": "string"
        },
        "pdfPages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 70
          }
        }
      }
    },
    "reviewStatus": {
      "enum": [
        "source-checked",
        "pending",
        "quarantined"
      ]
    },
    "clinicalApproval": {
      "enum": [
        "pending-human-review",
        "approved",
        "rejected"
      ]
    },
    "conceptId": {
      "type": "string"
    },
    "type": {
      "enum": [
        "mcq",
        "true-false",
        "recall",
        "fill",
        "matching",
        "ordering"
      ]
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    }
  }
}