{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge concept",
  "type": "object",
  "required": [
    "id",
    "title",
    "definition",
    "unitId",
    "lessonIds",
    "sourceReference",
    "reviewStatus",
    "clinicalApproval"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceReference": {
      "type": "object",
      "required": [
        "document",
        "pdfPages"
      ],
      "properties": {
        "document": {
          "type": "string"
        },
        "pdfPages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 70
          }
        }
      }
    },
    "reviewStatus": {
      "enum": [
        "source-checked",
        "pending",
        "quarantined"
      ]
    },
    "clinicalApproval": {
      "enum": [
        "pending-human-review",
        "approved",
        "rejected"
      ]
    },
    "title": {
      "type": "string"
    },
    "definition": {
      "type": "string"
    },
    "lessonIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "unitId": {
      "type": "string"
    }
  }
}